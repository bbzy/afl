{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vscode"],
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["**/*.ts", "**/*.cts"],
  "exclude": ["dist"]
}
