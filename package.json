{
  "name": "agent-friendly-lang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/checker",
    "packages/cli",
    "packages/lsp",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "nu --no-config-file tests/release/package.nu",
    "test:e2e": "npm run package && nu --no-config-file tests/vscode/vscode-e2e.nu",
    "release": "npm test && node scripts/package.mjs && npm run test:package && nu --no-config-file tests/vscode/vscode-e2e.nu",
    "typecheck": "tsc --build && tsc -p tests",
    "build": "npm run typecheck && npm run bundle --workspaces --if-present",
    "afl": "node packages/cli/bin/afl.mjs",
    "afl-lsp": "node packages/lsp/bin/afl-lsp.mjs",
    "test": "npm run build && nu --no-config-file tests/run.nu"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
